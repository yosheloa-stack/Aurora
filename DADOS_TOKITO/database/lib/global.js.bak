exports.apagado = () => {
return `*✅ | ᴏs ʜᴏʀᴀʀɪᴏs ᴅᴇ ᴀʙᴇʀᴛᴜʀᴀ ᴇ ғᴇᴄʜᴀᴍᴇɴᴛᴏ ғᴏʀᴀᴍ ʀᴇᴍᴏᴠɪᴅᴏs.*`
